<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.trai.mapper.BookTagMapper">
    <insert id="insertOne">
        insert into book_tag(tag_name) value (#{tagName})
    </insert>

    <select id="queryAll" resultType="org.example.trai.entity.PO.BookTagPO">
        select id, tag_name from book_tag where state=0
    </select>

    <select id="queryTagNameById" resultType="java.lang.String">
        select tag_name from book_tag where state=0 and id=#{bookTagId}
    </select>
</mapper>